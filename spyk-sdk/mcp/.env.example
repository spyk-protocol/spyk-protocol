# SPYK MCP Server Configuration

# Wallet Configuration (choose one method)
# =========================================

# Option 1: Base58-encoded private key
SPYK_PRIVATE_KEY=your_base58_private_key_here

# Option 2: Path to Solana CLI keypair file (supports ~)
# SPYK_KEYPAIR_PATH=~/.config/solana/id.json

# If neither is set, defaults to ~/.config/solana/id.json

# Network Configuration
# =====================

# Network: devnet or mainnet-beta (devnet recommended for hackathon)
SPYK_NETWORK=devnet

# Optional: Custom RPC URL (defaults to public endpoint for network)
# SPYK_RPC_URL=https://api.devnet.solana.com

# x402 Configuration
# ==================

# Use mock facilitator for x402 payments (for offline/testing)
SPYK_USE_MOCK_FACILITATOR=true

# Accept any payment proof (emergency fallback - use with caution)
# SPYK_ACCEPT_ALL_PROOFS=true
