{
  "name": "@spyk-protocol/cli",
  "version": "0.1.0",
  "description": "SPYK Protocol CLI - Private payments on Solana",
  "type": "module",
  "main": "dist/cli.mjs",
  "bin": {
    "spyk": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --experimental-strip-types src/cli.ts",
    "start": "node dist/cli.mjs",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "solana",
    "privacy",
    "spyk",
    "cli",
    "demo"
  ],
  "author": "Spyk Protocol",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "@spyk-protocol/sdk": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  }
}
